{
  "name": "ctf",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite --configLoader native build --watch",
    "build": "vite build --configLoader native",
    "fmt": "prettier --write .",
    "test": "vitest"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^26",
    "@types/webextension-polyfill": "^0.12.6",
    "@webext-core/fake-browser": "^2.0.1",
    "chrome-types": "^0.1.457",
    "http-z": "^8.1.1",
    "outdent": "^0.8.0",
    "prettier": "^3.9.10",
    "typescript": "^7",
    "unplugin-macros": "^0.23.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26",
      "onFail": "error"
    }
  },
  "keywords": [],
  "author": "nilfalse",
  "homepage": "https://nilfalse.com/addons/ctf",
  "license": "MPL-2.0",
  "prettier": {
    "plugins": [
      "@trivago/prettier-plugin-sort-imports"
    ],
    "importOrder": [
      "<BUILTIN_MODULES>",
      "<THIRD_PARTY_MODULES>",
      "^~(?!.*\\.css(?:\\?.*)?$)(.+)$",
      "^(?:\\.{1,2}/)(?!\\+)(?!.*\\.css(?:\\?.*)?$).*",
      "^\\./\\+.*$",
      "\\.css(?:\\?.*)?$"
    ],
    "importOrderSeparation": true,
    "singleQuote": true
  }
}
