{
  "compilerOptions": {
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.chromium.tsbuildinfo",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "esnext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    "paths": {
      "~/*": ["../*"]
    }
  },
  "files": ["types.chromium.d.ts"],
  "include": ["../webext/"],
  "exclude": ["../**/*moz.ts"]
}
